{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "name": "Screshot – Private Screenshot Tool with Blur, Annotate & Full Page Capture",
  "version": "2.1.0",
  "description": "Private screenshot tool: capture area or full page, blur & annotate on your device. Share only by end-to-end encrypted link.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_title": "Screshot"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "identity"
  ],
  "manifest_version": 3,
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "64": "icon64.png",
    "128": "icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Capture the visible area"
    },
    "capture_full_page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture the full page"
    }
  }
}
